# GENEROVÁNO scripts/server/hlavicky.mjs. Apache 2.4.57+; nahradit původní WP .htaccess.
# Nutné AllowOverride FileInfo Options AuthConfig a mod_rewrite/mod_headers/mod_authz_core.
Options -Indexes -MultiViews
AddDefaultCharset utf-8
ErrorDocument 404 /404.html
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)(^\\.|\\.(?:example|json)$|^_(?:headers|redirects)$)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Dotfiles všude; jen kořenová .well-known je výjimka, ne její skryté potomky.
  RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,END,NC]
  RewriteRule "^(?!\.well-known(?:/|$)).*/\.well-known(?:/|$)" - [F,END,NC]
  # Soukromé knihovny ani serverová konfigurace nejsou veřejná API.
  RewriteRule "^(?:api/_lib|server|mimo-www)(?:/|$)" - [F,END,NC]
  RewriteRule "(?:^|/)[^/]*\.(?:example|json)(?:/|$)" - [F,END,NC]
  # Nespoléhat na klientem podvržitelný X-Forwarded-Proto. WEDOS terminaci TLS ověřit.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.hotelchotoviny\.cz$ [NC]
  RewriteRule ^ https://www.hotelchotoviny.cz%{REQUEST_URI} [R=301,L]

# ZACATEK SPOLECNYCH REDIRECTU
