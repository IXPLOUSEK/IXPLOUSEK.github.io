RewriteRule ^zasady-cookies-eu$ https://www.hotelchotoviny.cz/cookies [R=301,L,NE]
RewriteRule ^vseobecne-obchodni-podminky/$ https://www.hotelchotoviny.cz/obchodni-podminky [R=301,L,NE]
RewriteRule ^vseobecne-obchodni-podminky$ https://www.hotelchotoviny.cz/obchodni-podminky [R=301,L,NE]
